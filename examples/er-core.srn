erDiagram

%% A small order book, written with every construct the ER renderer reads.

direction LR

CUSTOMER["Customer Account"] {
  string id PK "the account number"
  string name
  string email UK,FK
}

%% A cluster: a frame around the entities inside it, with a rank direction
%% of its own. The document above is LR; these two stack, because a block's
%% `direction` governs its own members and leaves the document's alone.
subgraph fulfilment
  direction TB

  ORDER {
    int number PK
    string status
  }

  LINE-ITEM {
    int quantity
    int price
  }
end

PRODUCT
WAREHOUSE

CUSTOMER ||--o{ ORDER : places
CUSTOMER |o..o| ADDRESS : "billed to"
ORDER ||--|{ LINE-ITEM : contains
LINE-ITEM }o--|| PRODUCT : names
PRODUCT }|.-|{ WAREHOUSE : stocked
PRODUCT one to zero or many LINE-ITEM : "appears in"
