flowchart TB
  Start[Start]
  Start --> Fetch[Fetch Data]
  Fetch --> Validate[Validate]
  Validate --> BranchA[Path A]
  Validate --> BranchB[Path B]
  BranchA --> Merge[Merge Results]
  BranchB --> Merge
  Merge --> Transform[Transform]
  Transform --> Cache[Cache Result]
  Transform --> Notify[Notify]
  Cache --> Publish[Publish]
  Notify --> Publish
  Publish --> End[Done]

timeline:
  enter Start fade
  enter Fetch slide-top, enter Start-Fetch fade
  enter Validate slide-left, enter Fetch-Validate slide-right
  enter BranchA slide-right, enter Validate-BranchA slide-top
  enter BranchB slide-bottom, enter Validate-BranchB slide-bottom
  highlight BranchA outline, highlight BranchB outline
  unhighlight BranchA, unhighlight BranchB
  enter Merge fade, enter BranchA-Merge fade, enter BranchB-Merge slide-left
  highlight Merge glow, highlight BranchA-Merge glow
  exit Start slide-top, exit Fetch slide-left, exit Start-Fetch fade, exit Fetch-Validate slide-top
  unhighlight Merge, unhighlight BranchA-Merge
  enter Transform slide-right, enter Merge-Transform fade
  exit BranchA slide-bottom, exit BranchA-Merge fade, exit Validate-BranchA slide-right
  exit BranchB slide-right, exit BranchB-Merge slide-top, exit Validate-BranchB slide-bottom
  enter Cache fade, enter Transform-Cache slide-left
  enter Notify slide-top, enter Transform-Notify slide-bottom
  highlight Cache outline, highlight Notify glow
  enter Publish fade, enter Cache-Publish fade, enter Notify-Publish fade
  unhighlight Cache, unhighlight Notify
  enter End slide-left, enter Publish-End fade
  highlight End glow
  highlight Publish-End outline
