{
  "name": "siren-core",
  "version": "0.1.0",
  "description": "A Mermaid-syntax diagram renderer with declarative step-reveal, highlight and enter/exit animation, authored in the same plain-text document.",
  "keywords": [
    "siren",
    "mermaid",
    "diagram",
    "flowchart",
    "sequence-diagram",
    "class-diagram",
    "state-diagram",
    "er-diagram",
    "svg",
    "animation",
    "step-reveal"
  ],
  "author": "kouhei",
  "license": "MIT",
  "homepage": "https://github.com/Ginz9013/siren/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ginz9013/siren.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Ginz9013/siren/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build && vite build --mode standalone && node ../../scripts/build-types.mjs && cp src/theme/default.css dist/theme.css",
    "prepublishOnly": "pnpm test && pnpm build",
    "probe": "node scripts/mermaid-probe.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "jsdom": "^25.0.1",
    "mermaid": "11.17.2",
    "typescript": "^5.6.3",
    "vite": "^8.2.2",
    "vitest": "^2.1.4"
  }
}
